# 复制为 .env.models.local，填写自己的凭证；不要提交真实 key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 以下为可选的 TypeSafe Decision 封闭集提速配置（未配置 TYPESAFE_API_KEY 时 auto 模式静默回退纯生成链路）
ENTITYTRACE_DECISION_MODE=auto
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest
